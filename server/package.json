{
  "name": "rule-based-trading-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js backend base for a rule-based trading system",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:watch": "node --watch src/index.js",
    "workers": "node src/jobs/workers.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:reset": "node src/db/migrate.js --reset",
    "db:seed:admin": "node src/db/seed_admin.js",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.5",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "dotenv-safe": "^9.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "kiteconnect": "^5.3.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "globals": "^15.9.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3"
  }
}
